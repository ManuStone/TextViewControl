<UserControl
    x:Class="TextViewControl.TextControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextViewControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid x:Name="MainGrid" ColumnDefinitions="auto,*" RowDefinitions="*,auto">
        <xaml:CanvasControl Grid.Column="0" x:Name="canvasLineNumbers" Draw="Canvas_LineNumber_Draw" HorizontalAlignment="Left" Width="100" VerticalAlignment="Stretch"/>
        <Grid Grid.Column="1" x:Name="scrollGrid" ColumnDefinitions="*,auto,auto">
            <xaml:CanvasControl Grid.Column="0" x:Name="canvasText" Draw="Canvas_Text_Draw" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerWheelChanged="canvasText_PointerWheelChanged">
                <xaml:CanvasControl.ContextFlyout>
                    <!-- The shortcuts are handled in CanvasText_KeyDown, the menu only shows them -->
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy All" Click="ContextMenu_CopyAll_Click" KeyboardAcceleratorTextOverride="Ctrl+X"/>
                        <MenuFlyoutItem Text="Select All" Click="ContextMenu_SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A"/>
                        <MenuFlyoutItem Text="Select Line" Click="ContextMenu_SelectLine_Click" KeyboardAcceleratorTextOverride="Ctrl+L"/>
                        <MenuFlyoutItem Text="Copy Selection" Click="ContextMenu_CopySelection_Click" KeyboardAcceleratorTextOverride="Ctrl+C"/>
                        <MenuFlyoutItem Text="Clear Selection" Click="ContextMenu_ClearSelection_Click" KeyboardAcceleratorTextOverride="Del"/>
                    </MenuFlyout>
                </xaml:CanvasControl.ContextFlyout>
            </xaml:CanvasControl>
            <ScrollBar Scroll="VerticalScrollbar_Scroll" Grid.Column="2" Maximum="0" Minimum="0" x:Name="VerticalScrollbar" Value="0" IndicatorMode="MouseIndicator" Background="Transparent" HorizontalAlignment="Right" Orientation="Vertical" VerticalAlignment="Stretch"/>
        </Grid>
        <ScrollBar Scroll="HorizontalScrollbar_Scroll" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="0" x:Name="HorizontalScrollbar" Value="0" IndicatorMode="MouseIndicator" Background="Transparent" HorizontalAlignment="Stretch" Orientation="Horizontal" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
